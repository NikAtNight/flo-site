{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Replaces the original LocalFlow site Worker, so it keeps the old name and domain.
  "name": "localflow-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "routes": [{ "pattern": "localflow.talix.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
